<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Burrow</string>
	<key>CFBundleDisplayName</key>
	<string>Burrow</string>
	<key>CFBundleIdentifier</key>
	<string>com.lfkdsk.burrow</string>
	<key>CFBundleExecutable</key>
	<string>Burrow</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.3</string>
	<key>CFBundleVersion</key>
	<string>4</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Burrow — Mac 系统维护工具</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Sparkle 自动更新配置 -->
	<!-- 仓库公开后,appcast 与更新包都由本仓库自身托管 -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/lfkdsk/burrow/main/appcast.xml</string>
	<!-- EdDSA 公钥(对应钥匙串中的 Sparkle 私钥;CI 用 SPARKLE_ED_PRIVATE_KEY 签名 appcast) -->
	<key>SUPublicEDKey</key>
	<string>uPdkH8REDyUW2BNIWSNtr09u7/7Lc9Me24F3yZ6PaT0=</string>
	<!-- 默认开启后台自动检查,每天一次(86400 秒) -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
